---
// A drawing copied from the atlas (phase 2 replaces these with figures drawn by the site).
import P from "../data/plates.json";
import { atlasUrl } from "../lib/atlas.js";
interface Props { sheet: string; wide?: boolean; label: string }
const { sheet, wide, label } = Astro.props;
// Interactive parts of atlas drawings stay in the atlas: strip their focus and button roles here,
// and point their internal links (#p3) at the atlas. A drawing that keeps links is a group, not an image.
let svg = (P[sheet] || "")
  .replace(/ tabindex="[^"]*"/g, "").replace(/(<(?:rect|circle|ellipse|path|line|polygon|g|text)\b[^>]*?) aria-label="[^"]*"/g, "$1").replace(/ role="button"/g, "").replace(/ aria-pressed="[^"]*"/g, "")
  .replace(/href="#([\w-]+)"/g, (m, id) => `href="${atlasUrl(id)}"`)
  .replace(/^<svg([^>]*?) role="[^"]*"/, "<svg$1").replace(/^<svg([^>]*?) aria-label="[^"]*"/, "<svg$1");
if (svg) svg = svg.replace("<svg", `<svg role="${svg.includes("<a ") ? "group" : "img"}" aria-label="${label.replace(/"/g, "&quot;")}"`);
---
{svg && (
  <figure class:list={["pic", { wide }]}>
    <Fragment set:html={svg} />
    <figcaption><slot /> <a href={atlasUrl(sheet)}>The full sheet in the atlas</a>.</figcaption>
  </figure>
)}

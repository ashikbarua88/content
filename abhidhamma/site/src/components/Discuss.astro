---
// "Reflect and discuss": the opening question, a private journal for the reader's own answer
// (kept in their browser, and in their account when signed in), one way of answering it, closed
// until opened, and the page's discussion. See src/scripts/community.js and supabase/.
interface Props { term: string; q: string; a?: string; title?: string }
const { term, q, a, title = "" } = Astro.props;
---
<section class="reflect" id="reflect" data-pagefind-ignore>
  <p class="lab">Opening question</p>
  <p class="q">{q}</p>
  <div class="journal" data-page={term} data-title={title} data-q={q}>
    <label class="lab" for={"j-" + term}>Your reflection</label>
    <textarea id={"j-" + term} rows="5" placeholder="Write your own answer first. Only you can see it."></textarea>
    <p class="jstatus muted ui" aria-live="polite"></p>
  </div>
  {a && <details><summary>One way to see it, after you have tried</summary><p>{a}</p></details>}
</section>
<section class="discussion" id="discuss-thread" data-page={term} data-pagefind-ignore>
  <h3>Discussion <span class="cm-count muted"></span></h3>
  <div class="cm-gate"></div>
  <div class="cm-form" hidden></div>
  <div class="cm-list" aria-live="polite"></div>
</section>
<script>
  import { initJournal, initDiscussion } from "../scripts/community.js";
  document.querySelectorAll(".journal").forEach((el) => initJournal(el));
  document.querySelectorAll(".discussion[data-page]").forEach((el) => initDiscussion(el));
</script>

 "cmaMap": [
  [
   "1",
   "The library",
   "Introduction (the Abhidhamma Piṭaka, commentaries, the Saṅgaha and its commentaries); I §1 (opening verse)"
  ],
  [
   "2",
   "From a person to dhammas",
   "I §2 (the four ultimate realities); VII §§34–40 (compendium of the whole: aggregates, bases, elements, truths); Introduction on the two truths"
  ],
  [
   "3",
   "A map of the 89",
   "I §§3–32 (all 89/121 cittas); III §§2–4 (compendium of feeling)"
  ],
  [
   "3b",
   "What each citta does",
   "III §§5–7 (roots), §§8–11 (functions), §§12–15 (doors), §§16–19 (objects), §§20–22 (bases)"
  ],
  [
   "4",
   "The 52 factors",
   "II §§1–9 (the 52 in four groups), with the guide's definitions"
  ],
  [
   "5",
   "How matter is made",
   "VI §§2–5 (enumeration), §§6–8 (classification), §§9–15 (origination), §§16–22 (kalāpas), §§23–29 (occurrence)"
  ],
  [
   "6",
   "The commentators' picture-book",
   "II guide (each factor's characteristic, function, manifestation, proximate cause); Vism XIV; Atthasālinī"
  ],
  [
   "7",
   "The mango and the moment",
   "IV §§1–11 (six kinds of process, the five-door process and intensity of objects); IV guide on the mango simile"
  ],
  [
   "8",
   "The web of 24 conditions",
   "VIII §§11–28 (the Paṭṭhāna method; the six kinds of relation; synthesis: all conditions fold into four)"
  ],
  [
   "9",
   "The wheel across three lives",
   "VIII §§2–10 (dependent origination: formula, periods, factors, modes, connections, groups, rounds, roots)"
  ],
  [
   "10",
   "Kamma, death and rebirth",
   "V §§18–33 (kamma: four ways, unwholesome and wholesome kamma, results), §§34–41 (death and rebirth); IV §21 (death-proximate javana)"
  ],
  [
   "11",
   "Thirty-one planes",
   "V §§2–8 (the four planes), §§9–17 (four kinds of rebirth-linking, lifespans)"
  ],
  [
   "12",
   "Forty meditation subjects",
   "IX §§2–21 (calm: subjects, temperaments, stages of development, signs, jhānas, direct knowledges)"
  ],
  [
   "13",
   "The tree of purification",
   "IX §§22–44 (insight: purifications, knowledges, emancipations, individuals, attainments)"
  ],
  [
   "14",
   "One moment, every lens",
   "Review: I, II, III §§8–22, IV §6, VI §§9–22, VIII; with the mango.json map"
  ],
  [
   "15",
   "Other maps of the same ground",
   "Introduction (other schools); not covered by the CMA: Abhidharmakośa, Vasubandhu's Hundred Dharmas"
  ]
 ],

---
import Base from "../layouts/Base.astro";
import M from "../data/map.json";
import { conceptUrl, u, links, linkTypes } from "../lib/atlas.js";
import { dhammaUrl, factors, matter, conditions, roleCond } from "../lib/dhammas.js";
import { listsGraph } from "../figures/graph.js";
const lists = listsGraph({ factors, matter, conditions, roleCond, url: dhammaUrl });

// The concept map (drawn for the atlas), with every idea a link to its concept page and every arrow
// carrying its two ends, so hovering an idea can light up its connections.
let svg = M.svg
  .replace(/^<svg([^>]*?) width="[^"]*"/, "<svg$1").replace(/^<svg([^>]*?) height="[^"]*"/, "<svg$1")
  .replace(/<g class="cmn" id="idea-(\w+)" data-id="\1"[^>]*aria-label="([^"]*)"[^>]*>([\s\S]*?)<\/g>/g,
    (m, id, label, inner) => `<a class="cmn-a" href="${conceptUrl(id)}" data-id="${id}" aria-label="${label}"><g class="cmn">${inner}</g></a>`)
  .replace(/<g class="cme" id="link-(\d+)" data-li="\1" role="button"[^>]*>/g,
    (m, i) => `<g class="cme" data-from="${links[i].from}" data-to="${links[i].to}">`)
  .replace(/aria-label="Concept map[^"]*"/, 'aria-label="Concept map of the sixteen ideas in six rows, joined by labelled arrows. Each idea links to its page."');
const types = Object.entries(linkTypes);
---
<Base title="Explore" nav="explore" description="The concept map of the sixteen ideas, and how the three lists of dhammas connect.">
  <div class="wrap" style="padding-top:34px">
    <h1>Explore</h1>
    <p class="dek" style="max-width:36em">The sixteen ideas on one map. Point at an idea to light up what it connects to; choose it to read about it.</p>
    <figure class="pic mapfig">
      <Fragment set:html={svg} />
      <figcaption>
        <span class="legend">{types.map(([k, [c, t]]) => <span><i style={`background:var(${c})`}></i>{t}</span>)}</span>
        Rows are the levels of study, from foundations at the top to the path at the bottom.
      </figcaption>
    </figure>

    <section class="band" style="border:0">
      <h2 style="margin-top:0">How the dhammas connect</h2>
      <p class="muted" style="max-width:40em">The three lists of <a href={u("dhammas/")}>dhammas</a> are not separate: mental factors and kinds of matter become the conditions that relate them. Choose any name to open its entry.</p>
      <figure class="pic drawn dh-graph"><div class="fig-scroll" tabindex="0"><Fragment set:html={lists} /></div></figure>
    </section>


  </div>
  <script is:inline>
    (function () {
      var svg = document.querySelector(".mapfig svg"); if (!svg) return;
      function on(id) {
        svg.classList.toggle("hl", !!id);
        svg.querySelectorAll(".cme").forEach(function (l) { l.classList.toggle("on", !!id && (l.dataset.from === id || l.dataset.to === id)); });
        svg.querySelectorAll(".cmn-a").forEach(function (n) {
          var near = id && (n.dataset.id === id || svg.querySelector('.cme.on[data-from="' + n.dataset.id + '"], .cme.on[data-to="' + n.dataset.id + '"]'));
          n.classList.toggle("on", !!near);
        });
      }
      svg.querySelectorAll(".cmn-a").forEach(function (n) {
        n.addEventListener("mouseenter", function () { on(n.dataset.id); });
        n.addEventListener("focus", function () { on(n.dataset.id); });
        n.addEventListener("mouseleave", function () { on(null); });
        n.addEventListener("blur", function () { on(null); });
      });
    })();
  </script>
</Base>

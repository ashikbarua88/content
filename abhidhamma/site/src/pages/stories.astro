---
import Base from "../layouts/Base.astro";
import { stories, storyKinds, levels, withGlosses, atlasUrl } from "../lib/atlas.js";
const ital = (s) => withGlosses(s.replace(/\(([a-zāīūṅñṭḍṇḷṃ]+)\)/g, "(<i>$1</i>)"));
---
<Base title="Stories" nav="stories" description="Stories from the Buddha's life, the Jātakas and the disciples, each read against an idea of the Abhidhamma.">
  <div class="wrap" style="max-width:820px;padding-top:34px">
    <h1>Stories</h1>
    <p class="dek">The Abhidhamma is abstract; its tradition is not. These stories come from the suttas, the Jātakas and the commentaries. Each is followed by a reading, marked as a study aid, that links it to an idea.</p>
    {Object.keys(stories).map((lv) => (
      <section>
        <h2>{levels[lv]?.name}</h2>
        <p class="muted">{levels[lv]?.q}</p>
        <div class="stories">
          {stories[lv].map((s) => (
            <div class="story">
              <h3>{s.t}</h3>
              <span class="src">{(storyKinds[s.k] || [""])[0]} · {s.src} · <a href={atlasUrl("S" + lv)}>in the atlas</a></span>
              <p>{s.s}</p>
              <p class="r" set:html={ital(s.r)} />
              {s.q && <p><i>{s.q}</i></p>}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

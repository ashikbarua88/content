---
import Base from "../../../layouts/Base.astro";
import { KINDS, dhammaUrl, readingsFor, ROLES, conditionBySlug, FIGURE_READING } from "../../../lib/dhammas.js";
import { conceptUrl, concept, atlasUrl, u, withGlosses } from "../../../lib/atlas.js";
import { BLOCKS } from "../../../figures/common.js";

export function getStaticPaths() {
  return Object.entries(KINDS).flatMap(([kind, K]) =>
    K.list.map((e, i) => ({ params: { kind, slug: e.slug }, props: { e, prev: K.list[i - 1], next: K.list[i + 1] } })));
}
const { e, prev, next } = Astro.props;
const K = KINDS[e.kind];
const card = e.card?.card;
const groupName = e.groupName || e.group;
const ital = (s) => withGlosses(s.replace(/\(([a-zāīūṅñṭḍṇḷṃ]+)\)/g, "(<i>$1</i>)"));
const readings = readingsFor(e);
const KIND_LABEL = { factors: "Mental factor", matter: "Matter", conditions: "Condition" };
const COLOR = { factors: "var(--nama)", matter: "var(--rupa)", conditions: "var(--nib)" };

// At a glance: the few facts that place this entry.
const glance = [];
if (e.kind === "factors") glance.push(["Occurs in", e.n89 === 89 ? "every citta" : `${e.n89} of 89 cittas`]);
if (e.kind === "matter") glance.push(["Origins", e.origins.length ? e.origins.join(", ") : "none of its own"], ["Kind", e.concrete ? "concrete" : "a quality of matter"]);
if (e.kind === "conditions") glance.push(["Direction", e.group], ...(e.synthesis ? [["Synthesis", `one of the four: ${e.synthesis}`]] : []));
glance.push(["Group", groupName], ["Manual", K.ch]);
const fig = FIGURE_READING[e.kind];
---
<Base title={`${e.en} (${e.pali})`} description={e.text} nav="dhammas">
  <div class="wrap page dh-entry" style={`--c:${COLOR[e.kind]}`}>
    <article>
      <p class="crumbs"><a href={u("dhammas/")}>Dhammas</a> › <a href={u("dhammas/#" + e.kind)}>{K.short}</a> › {groupName}</p>
      <header>
        <p class="dh-badge ui">{KIND_LABEL[e.kind]}{e.n ? ` · ${e.n} of 24` : ""}</p>
        <h1>{e.en[0].toUpperCase() + e.en.slice(1)}</h1>
        <p class="pali-line" lang="pi">{e.pali}</p>
        <p class="dek" set:html={ital(e.text)} />
      </header>

      <dl class="dh-glance">{glance.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>

      {card && (
        <section>
          <h2>Four ways to know it</h2>
          <dl class="facts">
            <dt>Characteristic</dt><dd>{card[0]}</dd>
            <dt>Function</dt><dd>{card[1]}</dd>
            <dt>Manifestation</dt><dd>{card[2]}</dd>
            <dt>Proximate cause</dt><dd>{card[3]}</dd>
          </dl>
          {e.card.notice && <p class="note" style="margin-top:14px">Try it: {e.card.notice}</p>}
        </section>
      )}

      <section id="connections">
        <h2>Connections</h2>

        {e.related?.length > 0 && (
          <div class="dh-block">
            <h3 class="lab">Related entries</h3>
            <ul class="dh-rel">
              {e.related.map((r) => (
                <li><a href={dhammaUrl(r.entry)}><i lang="pi">{r.entry.pali}</i> <span>{r.entry.en}</span></a><span class="how">{r.how}</span></li>
              ))}
            </ul>
          </div>
        )}

        {e.kind === "factors" && e.roles.length > 0 && (
          <div class="dh-block">
            <h3 class="lab">Roles in the other lists</h3>
            <ul class="dh-roles">
              {e.roles.map((r) => { const [label, cond] = ROLES[r]; const c = cond && conditionBySlug(cond); return (
                <li>{label}{c && <> · as <a href={dhammaUrl(c)}>{c.en} condition</a></>}</li>
              ); })}
            </ul>
          </div>
        )}

        {e.kind === "factors" && e.occurrence && (
          <div class="dh-block">
            <h3 class="lab">Where it occurs</h3>
            <div class="dh-strip" role="img" aria-label={`Occurrence across the 89 cittas: ${e.occurrence.parts.map((p) => p.text).join("; ")}`}>
              {[...e.occurrence.occ].map((ch, i) => <i class={ch === "F" ? "f" : ch === "." ? "" : "u"} style={`--b:${BLOCKS.find((b) => i + 1 >= b.from && i + 1 <= b.to).style.replace("fill:", "")}`}></i>)}
            </div>
            <ul class="dh-occ">{e.occurrence.parts.map((p) => <li>{p.text}</li>)}</ul>
            {e.occurrence.never.length > 0 && <p class="muted ui dh-never">Never in: {e.occurrence.never.join(", ")}.</p>}
            {e.note && <p class="note">{e.note}</p>}
          </div>
        )}

        {e.kind === "matter" && (
          <div class="dh-block">
            <h3 class="lab">In the groups of matter</h3>
            {e.kalapas.all ? <p>In every one of the 21 groups: it is one of the eight inseparables.</p>
              : e.kalapas.list.length ? <ul class="dh-occ">{e.kalapas.list.map((g) => <li>{g}</li>)}</ul>
              : <p class="muted">Not a member of any group: it is a mode or mark of the groups, not counted among them.</p>}
          </div>
        )}

        {e.lists?.length > 0 && (
          <div class="dh-block">
            <h3 class="lab">In the lists of chapter VII</h3>
            <ul class="dh-occ">{e.lists.map((l) => <li><i lang="pi">{l.pali}</i>, {l.en} <span class="muted ui">· {l.list}</span></li>)}</ul>
          </div>
        )}

        {e.mixed && (
          <div class="dh-block">
            <h3 class="lab">The same factors, as a category</h3>
            <p>In chapter VII, the {e.mixed.cat} work as this condition. {e.mixed.note}</p>
          </div>
        )}

        <div class="dh-block">
          <h3 class="lab">In the readings</h3>
          {readings.length ? <ul class="dh-occ">{readings.map((r) => <li><a href={u(`readings/${r.id}/`)}>{r.title}</a></li>)}</ul>
            : <p class="muted">Not named in a reading yet. Its list is drawn in <a href={u(`readings/${fig[0]}/`)}>{fig[1]}</a>.</p>}
        </div>
      </section>

      <p class="note" style="margin-top:28px">Part of <a href={conceptUrl(K.concept)}>{concept(K.concept).title}</a>. Described after the commentaries, in the order of the <i>Manual</i>; not quoted from it. <a href={atlasUrl(K.plate)}>The atlas plate</a>.</p>

      <nav class="pn" aria-label="Previous and next entry">
        {prev && <a href={dhammaUrl(prev)}><small>Previous</small><span class="t">{prev.en}</span></a>}
        {next && <a class="next" href={dhammaUrl(next)}><small>Next</small><span class="t">{next.en}</span></a>}
      </nav>
    </article>
    <aside data-pagefind-ignore>
      <div class="box">
        <div>
          <p class="lab">{groupName}</p>
          <ul>{K.list.filter((x) => (x.groupName || x.group) === groupName).map((x) => <li><a href={dhammaUrl(x)} aria-current={x === e ? "page" : undefined}>{x.en}</a></li>)}</ul>
        </div>
        <div><p class="lab">In a figure</p><a href={u(`readings/${fig[0]}/`)}>{fig[1]}</a></div>
        <div><p class="lab">All entries</p><a href={u("dhammas/#" + e.kind)}>{K.t}</a></div>
      </div>
    </aside>
  </div>
</Base>

---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { levels, u } from "../../lib/atlas.js";
import { KINDS, conditions, dhammaUrl, gist } from "../../lib/dhammas.js";
const models = (await getCollection("models3d")).sort((a, b) => a.data.level - b.data.level);
// The 24 conditions by direction, for the level-4 model (from kinds.yaml and conditions.yaml).
const condData = KINDS.conditions.groups.map((g) => ({ key: g.key, title: g.title, desc: g.desc, from: g.from, to: g.to,
  conds: conditions.filter((c) => c.dir === g.key).map((c) => ({ n: c.n, pali: c.pali, en: c.en, url: dhammaUrl(c), gist: gist(c.text), ways: c.ways })) }));
// The twelve links (links12.yaml) and the level-4 notes (views of the helix, and the three kinds of state).
const d4 = models.find((m) => m.id === "D4");
const notes = Object.fromEntries((d4?.data.notes || []).map((n) => [n.id, n]));
const links = (await getCollection("links12")).map((l) => l.data).sort((a, b) => a.n - b.n);
---
<Base title="In three dimensions" nav="explore" description="Seven 3D models, one for each level of study: turn them, take them apart, and see the categories, elements, processes, conditions, planes, practice and one moment in depth.">
  <div class="wrap m3page" style="max-width:980px;padding-top:34px">
    <p class="crumbs"><a href={u("explore/")}>Explore</a> › In three dimensions</p>
    <h1>In three dimensions</h1>
    <p class="dek" style="max-width:38em">Seven models, one for each level of study. Drag any model to turn it; the buttons above a model change what it shows. Each comes with a caption that says what to look for.</p>
    <nav class="m3toc" aria-label="Models">
      {models.map((m) => <a href={"#" + m.id}><span class="lv">Level {m.data.level}</span>{m.data.title}</a>)}
    </nav>
    {models.map((m) => (
      <section class="m3sec d3p" id={m.id}>
        <p class="lab">Level {m.data.level} · {levels[m.data.level]?.name}</p>
        <h2>{m.data.title}</h2>
        <p class="lede">{m.data.lede}</p>
        <Fragment set:html={m.data.html} />
        {m.data.sources && <p class="src ui">Sources: <Fragment set:html={m.data.sources.replace(/^Sources:\s*/, "")} /></p>}
      </section>
    ))}
  </div>
  <script type="application/json" id="d4-comp-data" set:html={JSON.stringify({ fams: condData, notes })} />
  <script type="application/json" id="d4-helix-data" set:html={JSON.stringify({ links, notes })} />
  <script>
    import "../../scripts/three-models.js";
  </script>
</Base>
